# 模型服务（完整质检模式必填）
SJTU_API_BASE_URL=https://models.example.com/api/v1
SJTU_API_KEY=replace_me
QC_PRIMARY_MODEL=qwen
QC_CLEAN_VERIFIER_MODEL=qwen3.6-27b

# Web 访问保护（部署到共享服务器时建议必填）
QC_WEB_USERNAME=qc_user
QC_WEB_PASSWORD=replace_with_a_strong_password
QC_REQUIRE_AUTH=true

# 运行与上传限制
QC_PORT=7860
QC_MAX_UPLOAD_MB=2048
QC_MAX_EXTRACTED_MB=8192
QC_MAX_ARCHIVE_FILES=30000
QC_KEEP_INPUTS=false
